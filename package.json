{
  "name": "atelier-analytics",
  "version": "1.0.0",
  "description": "Next-Gen In-Browser Visual Analytics Studio powered by DuckDB-WASM, Apache Arrow, and Observable Plot with Tableau declarative grammar.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "analytics",
    "bi",
    "tableau",
    "duckdb",
    "wasm",
    "observable-plot",
    "data-visualization",
    "arrow",
    "sql"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@observablehq/plot": "^0.6.16",
    "apache-arrow": "^18.1.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
